    <!-- 设置：AI 操控 -->
    <string name="ai_control_title">AI 操控手机（后台操作 + 实时镜像）</string>
    <string name="ai_control_desc">AI 用无障碍服务在后台操控真机，不影响你正常使用其他 App；操控期间可开启实时镜像小窗围观画面。</string>
    <string name="ai_control_toggle">允许 AI 后台操控</string>
    <string name="ai_control_toggle_desc">关闭后 accessibility_control 工具会被拒绝</string>
    <string name="ai_control_mirror">操控时显示镜像小窗</string>
    <string name="ai_control_mirror_desc">需悬浮窗权限；无权限时退化为仅通知栏提示</string>
    <string name="ai_control_confirm">操控前需要确认</string>
    <string name="ai_control_confirm_desc">开启后每次操控前会先弹窗征得你同意</string>
    <string name="ai_control_not_enabled">⚠️ 无障碍服务尚未开启，请先在系统设置中授权</string>
    <string name="a11y_guide_title">需要开启无障碍服务</string>
    <string name="a11y_guide_body">AI 后台操控依赖 Android 无障碍服务。请完成以下操作：\n1. 点击「去系统设置」\n2. 找到「Ai Android 手机操控」\n3. 打开开关并允许无障碍权限\n4. 返回本 App 即可正常使用</string>
    <string name="a11y_guide_go">去系统设置</string>
    <string name="a11y_guide_later">稍后再说</string>

